#ifndef _HAS_NEO_H
#define _HAS_NEO_H

#include <stdio.h>
#include <stdint.h>

#include "worker.h"

#define NEO_VERSION_MAJOR	@NEO_VERSION_MAJOR@
#define NEO_VERSION_MINOR	@NEO_VERSION_MINOR@

#cmakedefine PROJECT_NAME		"@PROJECT_NAME@"

#define NEO_CFG_FILE		"@NEO_CFG_FILE@"
#define NEO_NEURON_DIR		"@NEO_NEURON_DIR@"
#define NEO_DEBUG		@NEO_DEBUG@

#define DEFAULT_ARRAY_SIZE	16
#define ARCH_MAXLEN		16
#define NEO_PATH_MAX		256
#define NEO_VAR_MAX		64
#define NEO_WORKERS_MIN		2
#define NEO_WORKQUEUE_SIZE	8192

#define NEO_INIT	__attribute__((constructor))
#define NEO_FINI	__attribute__((destructor))

#define pr_info(fmt, ...)	fprintf(stdout, "\033[1;32m[ INFO ]\033[0m " fmt "\n", ##__VA_ARGS__)
#define pr_warn(fmt, ...)	fprintf(stderr, "\033[1;33m[ WARN ]\033[0m " fmt "\n", ##__VA_ARGS__)
#define pr_err(fmt, ...)	fprintf(stderr, "\033[1;31m[  ERR ]\033[0m " fmt "\n", ##__VA_ARGS__)
#define pr_trace(fmt, ...)	fprintf(stdout, "\033[1;32m[ TRACE]\033[0m " fmt "\n", ##__VA_ARGS__)
#define pr_neo(fmt, ...)	fprintf(stdout, "\t\033[1;42m[NEO]\033[0m " fmt "\n", ##__VA_ARGS__)

#define NEW_NEURON(neuron_name, thread, check_support)	\
struct neuron _config = {		\
	.name = neuron_name,		\
	.support = check_support,	\
	.neuron = thread,		\
	.prev = NULL,			\
	.next = NULL,			\
};	\
void NEO_INIT __init_##neoron_name(void) {_register(&_config);} \
void NEO_FINI __fini_##neoron_name(void) {}

enum db_types {
	DB_UNKNOWN = 0,
	DB_MYSQL
};

struct environ_s {
	uint16_t lcores;
	int kern_version;
	char kern_ver[12];
	char arch[ARCH_MAXLEN];
	int accel_devs;	/* TODO: Should be a list of devices */
};

struct db_s {
	enum db_types type;
	char host[NEO_VAR_MAX];
	char user[NEO_VAR_MAX];
	char passwd[NEO_VAR_MAX];
};

struct neo_cfg_s {
	char neuron_dir[NEO_PATH_MAX];
	char stage_file[NEO_PATH_MAX];
	struct runner runner;

	struct db_s db;
	struct environ_s env;
	struct neuron *plugins;
	int plugin_cnt;
	const char *cfg_file;
};

int neo_init(struct neo_cfg_s *cfg);
int neo_fini(struct neo_cfg_s *cfg);
int neo_load_neurons(struct neo_cfg_s *cfg);
int get_sysinfo(struct environ_s *env);
#endif	/* _HAS_NEO_H */
